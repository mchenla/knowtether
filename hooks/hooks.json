{
  "description": "KnowTether advisory hooks; bundled Python 3.10+ code, no pip install, no blocking.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/run-posix.sh\" SessionStart",
            "commandWindows": "cmd.exe /d /v:on /c \"!PLUGIN_ROOT!\\hooks\\run-windows.cmd\" SessionStart",
            "timeout": 10,
            "statusMessage": "KnowTether: SessionStart",
            "additionalContextLimit": 1600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/run-posix.sh\" UserPromptSubmit",
            "commandWindows": "cmd.exe /d /v:on /c \"!PLUGIN_ROOT!\\hooks\\run-windows.cmd\" UserPromptSubmit",
            "timeout": 10,
            "statusMessage": "KnowTether: UserPromptSubmit",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/hooks/run-posix.sh\" Stop",
            "commandWindows": "cmd.exe /d /v:on /c \"!PLUGIN_ROOT!\\hooks\\run-windows.cmd\" Stop",
            "timeout": 10,
            "statusMessage": "KnowTether: Stop"
          }
        ]
      }
    ]
  }
}
