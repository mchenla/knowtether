{
  "name": "KPDM",
  "display_name": "知识产品开发元模型",
  "english_name": "Knowledge Product Development Meta-Model",
  "namespace": "KPDM",
  "version": "0.5.0-rc.2",
  "status": "trial",
  "positioning": "由人主导、AI Agent 主动辅助的原创知识开发框架，支持框架或知识体系、书籍、文章、报告及系列成果；人掌握问题选择、思想发展、价值取舍、核心主张和最终表达，Agent 在明确授权内研究、提议、质疑、起草和核验。",
  "legacy_namespaces": [
    "Meta-Framework",
    "MF"
  ],
  "universal_principles": [
    "truth-first",
    "problem-and-audience-first",
    "predefine-quality-height",
    "objects-before-expression",
    "claim-evidence-fit",
    "originality-with-provenance",
    "citation-and-permission-separated",
    "human-accountability",
    "production-validation-separation",
    "traceability-and-reproducibility",
    "privacy-security-confidentiality",
    "disclose-boundaries-failures-corrections"
  ],
  "release_redlines": [
    "untraceable-core-facts-or-data",
    "unverified-or-fabricated-citations",
    "unknown-rights-for-reproduced-or-adapted-material",
    "unverified-ai-generated-facts-quotes-or-data",
    "unauthorized-sensitive-information",
    "marketing-claims-exceed-evidence",
    "concealed-authorship-conflict-or-material-ai-use"
  ],
  "quality_levels": [
    {
      "id": "Q0",
