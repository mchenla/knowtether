  "layered_model": {
    "core": [
      "purpose",
      "knowledge",
      "grounding",
      "enablement",
      "expression",
      "validation-evolution"
    ],
    "quality_constraints": [
      "truthfulness",
      "human-understandability",
      "concept-restraint",
      "rights-safety-privacy",
      "epistemic-honesty",
      "traceability"
    ],
    "production_controls": [
      "context-work",
      "authority-evidence",
      "human-ai-collaboration",
      "quality-uncertainty",
      "validation-release",
      "decisions-evolution"
    ]
  },
  "human_leadership": {
    "human_decides": [
      "purpose-audience",
      "core-claims-values",
      "original-contribution",
      "acceptance-of-expression",
      "risk-release"
    ],
    "agent_may": [
      "research",
      "propose-alternatives",
      "challenge",
      "draft",
      "verify",
      "organize"
    ],
    "approval_unit": "identified-version",
    "agent_proposals": "candidates-until-human-acceptance"
  },
  "outcome_view": {
    "knowledge-kernel": [
      "knowledge",
      "grounding"
    ],
    "use-system": [
      "enablement"
    ],
    "expression-product": [
      "expression"
    ],
    "evolution-system": [
      "validation-evolution"
    ],
    "purpose": "cross-cutting"
  },
  "status_claim_policy": {
    "representation": "Claim subtype",
    "claim_type": "status",
    "required": [
      "subject",
      "scope",
      "criteria",
      "evidence",
      "verifier",
      "version",
      "limitations"
    ],
    "no_extra_meta_object": true
  },
  "profile_quality_policy": {
    "report": "内部报告默认Q2；对外发布至少Q3；高风险事实另行加严核验。"
  },
  "creative_extension": {
    "current_scope": "knowledge-creation",
    "future_scope": [
      "literature",
      "arts"
    ],
    "replaceable": [
      "purpose",
      "product-structure",
      "evaluation-method"
    ],
    "retain": [
      "truthfulness-about-real-facts",
      "rights-safety-privacy",
      "human-accountability"
    ],
    "implemented": false
  },
  "lightweight_profile": {
    "records": 1,
    "fields": [
      "intent",
      "central-idea",
      "structure",
      "grounding-boundaries",
      "delegation",
      "acceptance-tests",
      "results-revisions",
      "human-decision"
    ],
    "quality": "Q1 pilot allowed; Q3 required before public release",
    "escalate_on": [
      "sensitive-or-high-stakes-facts",
      "unresolved-rights",
      "new-core-claim",
      "multiple-conflicting-inputs"
    ],
    "not_proven": [
      "human-usability",
      "time-savings",
      "external-validity"
    ]
  },
  "profile_extensions": [
    {
      "id": "report",
      "default_quality": "Q2"
    }
  ],
  "documents": {
    "quick-start": "00 Start/快速入门.md",
    "constitution": "01 Foundations/KPDM 三层元模型.md",
    "object-model": "01 Foundations/KPDM 元模型.md",
    "quality-constraints": "01 Foundations/KPDM 质量约束.md",
    "namespace": "01 Foundations/命名空间与定位.md",
    "product-requirements": "01 Foundations/KPDM 产品需求文档.md",
    "production-controls": "02 Methods and Protocols/KPDM 生产控制层.md",
    "human-ai": "02 Methods and Protocols/人机协作协议.md",
    "context-work": "02 Methods and Protocols/上下文包与工作包协议.md",
    "authority-evidence-rights": "02 Methods and Protocols/权威、主张、证据与引用治理.md",
    "profiles": "02 Methods and Protocols/知识产品类型适配.md",
    "regression-release-versioning": "02 Methods and Protocols/回归测试、Golden Case与发布候选.md",
    "quality-levels-verification": "03 Quality and Governance/质量高度与验收等级.md",
    "release-gate": "03 Quality and Governance/发布前合规与完整性检查.md",
    "lightweight-worksheet-template": "04 Templates/轻量工作单模板.md",
    "knowledge-overview-template": "04 Templates/知识概览模板.md",
    "requirements-map": "08 Evolution/KPDM 0.5 需求映射与迁移.md"
  },
  "status_model": {
    "production": [
      "registered",
      "drafted",
      "structurally-reviewed",
      "author-accepted"
    ],
    "quality": [
      "criterion-ready",
      "calibrated",
      "field-piloted",
      "independently-validated"
    ],
    "release": [
      "candidate",
      "release-approved",
      "withdrawn"
    ],
    "qualifier": [
      "self-assessed",
      "provisional",
      "unverified"
    ],
    "rule": "production, quality and release states are recorded separately; none of them alone permits registering a release pass"
  },
  "escalation_triggers": [
    "data-or-strong-causal-or-high-impact-advice",
    "unclear-rights-or-sensitive-material",
    "multi-unit-or-multi-person-dependency",
    "core-definition-or-method-change",
    "public-release"
  ],
  "return_to_human": [
    "new-core-claim",
    "author-intent-changed",
    "scope-materially-expanded",
    "unauthorized-risk",
    "critical-check-failed",
    "unresolvable-substantive-disagreement"
  ],
  "research_loop": {
    "entry": [
      "goal-clear-fill-gaps-only",
      "question-open-research-first"
    ],
    "steps": [
      "multi-angle-questions-with-reasons",
      "find-material-keep-locator",
      "follow-up-on-conflict-condition-gap",
      "update-overview-and-question-status"
    ],
    "stop_conditions": [
      "coverage-target-reached",
      "human-requests-convergence",
      "budget-exhausted",
      "two-rounds-no-new-relevant-information"
    ],
    "human_controls": [
      "add-material",
      "correct",
      "narrow-scope",
      "pause",
      "converge"
    ],
    "deliverable_may_be_overview_only": true,
    "budget_exhausted_is_not_sufficiency": false
  },
  "blocking_conditions": [
    "unaccepted-new-core-claim-written-as-author-position",
    "fabricated-facts-citations-human-feedback-or-approvals",
    "public-output-without-q3-checks-or-reader-cannot-complete-key-task",
    "prose-template-machine-conflict-on-core-rule",
    "lighter-records-lost-required-source-risk-responsibility-or-acceptance",
    "expansion-after-stop-or-narrowing-or-budget-exhaustion-written-as-resolved",
    "accessible-citation-not-supporting-claim-or-speculative-relation-as-verified"
  ],
  "material_record_fields": [
    "identifier",
    "version-or-access-time",
    "supporting-locator",
    "question",
    "verification-status",
    "usage-restriction",
    "rights-status"
  ],
  "baseline_version": "0.4.0",
  "acceptance": {
    "author_accepted": false,
    "note": "0.5.0-rc.2 candidate awaiting author acceptance; last accepted baseline is 0.4.0 trial / conditional-pass"
  }
}
