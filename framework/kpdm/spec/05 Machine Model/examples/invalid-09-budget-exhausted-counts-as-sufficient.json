        "not-yet-migrated-to-kpdm-production-objects"
      ]
    },
    {
      "project": "Meta-Framework-v0.3-self-bootstrap",
      "profile": "knowledge-system",
      "result": "conditional-pass",
      "limitations": [
        "legacy-namespace",
        "self-referential-case",
        "not-cross-project-validation"
      ]
